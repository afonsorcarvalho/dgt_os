<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    Layout dos formulários de campo (preenchidos à mão pelo técnico).
    Não usa web.external_layout: cabeçalho próprio só com a logo da empresa
    da OS (multiempresa) e paperformat de margem curta pra sobrar espaço.
    Tabelas + CSS em mm/pt: wkhtmltopdf ignora parte do grid bootstrap.
    Uso: t-set title / form_version, depois t-call com o corpo do formulário.
-->
<template id="dgt_os.report_campo_layout">
    <t t-set="company" t-value="o.company_id or res_company"/>
    <t t-set="company_info" t-value="' · '.join(x for x in [
        company.name,
        company.partner_id.cnpj_cpf and 'CNPJ ' + company.partner_id.cnpj_cpf,
        company.phone and 'Tel. ' + company.phone,
        company.email,
    ] if x)"/>
    <div class="footer" style="font-size: 7.5pt; color: #444; padding-top: 3mm; text-align: center;">
        <div style="border-top: 0.35mm solid #444; padding-top: 1.2mm;">
            <div t-esc="company_info"/>
            <div style="color: #555;">
                <span style="float: left;"><t t-esc="o.name"/> · Formulário <t t-esc="form_version"/></span>
                <span style="float: right;">Página <span class="page"/> / <span class="topage"/></span>
                &#160;
            </div>
        </div>
    </div>
    <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
        <div class="page osc">
            <style>
                .osc { font-size: 10pt; color: #111; }
                .osc table { width: 100%; border-collapse: collapse; margin: 0; }
                .osc td, .osc th { padding: 0; vertical-align: middle; }
                .osc-title td { padding-bottom: 1.2mm; border-bottom: 0.6mm solid #222; vertical-align: bottom; }
                .osc-logo { width: 38mm; }
                .osc-logo img { max-height: 12mm; max-width: 36mm; }
                .osc-company { font-size: 12pt; font-weight: bold; }
                .osc-title-main { font-size: 13pt; white-space: nowrap; font-weight: bold; letter-spacing: 0.3pt; text-align: center; }
                .osc-num { border: 0.4mm solid #222; padding: 0.8mm 2mm !important; text-align: center; width: 38mm; }
                .osc-num-label { font-size: 7.5pt; color: #444; text-transform: uppercase; }
                .osc-num-value { font-size: 13pt; font-weight: bold; }
                .osc-sec { margin-top: 2mm; font-size: 9pt; font-weight: bold; text-transform: uppercase;
                           letter-spacing: 0.6pt; border-bottom: 0.3mm solid #222; padding-bottom: 0.6mm; margin-bottom: 1mm; }
                .osc-grid td { border: 0.25mm solid #777; padding: 0.6mm 1.8mm; height: 8mm; vertical-align: top; }
                .osc-lbl { display: block; font-size: 7.5pt; color: #444; text-transform: uppercase; letter-spacing: 0.3pt; }
                .osc-val { display: block; font-size: 10pt; font-weight: bold; margin-top: 0.3mm; }
                .osc-val-blank { display: block; font-size: 10pt; color: #888; margin-top: 0.3mm; }
                .osc-box { display: inline-block; width: 3.8mm; height: 3.8mm; border: 0.3mm solid #222;
                           vertical-align: middle; margin-right: 1.5mm; }
                .osc-opt td { padding: 0.8mm 0; font-size: 10pt; white-space: nowrap; }
                .osc-ruled td { height: 7mm; border-bottom: 0.3mm solid #777; }
                .osc-parts th { font-size: 7.5pt; color: #444; text-transform: uppercase; text-align: left;
                                border-bottom: 0.3mm solid #222; padding: 0.8mm 2mm; }
                .osc-parts td { height: 7mm; border-bottom: 0.3mm solid #777; border-left: 0.25mm solid #777; }
                .osc-parts td:first-child { border-left: none; }
                .osc-sign td { vertical-align: bottom; padding: 0 3mm; }
                .osc-sign-line { border-top: 0.3mm solid #222; padding-top: 1mm; text-align: center; font-size: 8.5pt; }
                .osc-small { font-size: 9pt; color: #222; padding-top: 1mm !important; }
            </style>

            <table class="osc-title">
                <tr>
                    <td class="osc-logo">
                        <img t-if="company.logo" t-att-src="'data:image/png;base64,%s' % to_text(company.logo)"/>
                        <span t-if="not company.logo" class="osc-company" t-esc="company.name"/>
                    </td>
                    <td>
                        <div class="osc-title-main" t-esc="title"/>
                    </td>
                    <td class="osc-num">
                        <div class="osc-num-label">Nº da OS</div>
                        <div class="osc-num-value"><span t-field="o.name"/></div>
                    </td>
                </tr>
            </table>

            <t t-raw="0"/>
        </div>
    </div>
</template>

<template id="dgt_os.report_campo_cliente_equipamento">
    <t t-set="cli" t-value="o.cliente_id"/>
    <t t-set="cli_address" t-value="', '.join(x for x in [
        ', '.join(y for y in [cli.street, cli.number] if y),
        cli.district,
        cli.street2,
        ' - '.join(y for y in [cli.city_id.name, cli.state_id.code] if y),
        cli.zip and 'CEP ' + cli.zip,
    ] if x)"/>
    <div class="osc-sec">Cliente</div>
    <table class="osc-grid">
        <tr>
            <td style="width: 52%;">
                <span class="osc-lbl">Razão social / Nome</span>
                <span class="osc-val" t-field="o.cliente_id.name"/>
            </td>
            <td style="width: 22%;">
                <span class="osc-lbl">CNPJ / CPF</span>
                <span class="osc-val" t-field="o.cliente_id.cnpj_cpf"/>
            </td>
            <td>
                <span class="osc-lbl">Telefone</span>
                <span class="osc-val" style="font-weight: normal;" t-esc="' / '.join(x for x in [cli.phone, cli.mobile] if x)"/>
            </td>
        </tr>
        <tr>
            <td colspan="3">
                <span class="osc-lbl">Endereço</span>
                <span class="osc-val" style="font-weight: normal;" t-esc="cli_address"/>
            </td>
        </tr>
        <tr>
            <td>
                <span class="osc-lbl">Contato no local</span>
            </td>
            <td colspan="2">
                <span class="osc-lbl">Setor</span>
            </td>
        </tr>
    </table>

    <div class="osc-sec">Equipamento</div>
    <table class="osc-grid">
        <tr>
            <td style="width: 40%;">
                <span class="osc-lbl">Equipamento</span>
                <span class="osc-val" t-field="o.equipment_id.name"/>
            </td>
            <td style="width: 30%;">
                <span class="osc-lbl">Modelo</span>
                <span class="osc-val" t-esc="o.equipment_id.model or ''"/>
            </td>
            <td>
                <span class="osc-lbl">Nº de série</span>
                <span class="osc-val" t-esc="o.equipment_id.serial_number or ''"/>
            </td>
        </tr>
        <tr>
            <td style="width: 40%;">
                <span class="osc-lbl">Patrimônio</span>
                <span class="osc-val" t-esc="o.equipment_id.patrimony or ''"/>
            </td>
            <td style="width: 30%;">
                <span class="osc-lbl">TAG</span>
                <span class="osc-val" t-esc="o.equipment_id.tag or ''"/>
            </td>
            <td>
                <span class="osc-lbl">Local</span>
                <span class="osc-val" t-esc="o.equipment_id.location_id.name or ''"/>
            </td>
        </tr>
    </table>
</template>

<template id="dgt_os.report_campo_execucao">
    <table class="osc-grid">
        <tr>
            <td style="width: 25%;"><span class="osc-lbl">Data início</span><span class="osc-val-blank">____/____/________</span></td>
            <td style="width: 25%;"><span class="osc-lbl">Hora início</span><span class="osc-val-blank">____:____</span></td>
            <td style="width: 25%;"><span class="osc-lbl">Data término</span><span class="osc-val-blank">____/____/________</span></td>
            <td><span class="osc-lbl">Hora término</span><span class="osc-val-blank">____:____</span></td>
        </tr>
    </table>
</template>

<template id="dgt_os.report_campo_assinaturas">
    <table class="osc-opt" style="margin-top: 1mm; page-break-inside: avoid;">
        <tr>
            <td style="width: 22%;"><strong>Equipamento ficou:</strong></td>
            <td style="width: 20%;"><span class="osc-box"/>Funcionando</td>
            <td style="width: 30%;"><span class="osc-box"/>Funcionando com restrição</td>
            <td><span class="osc-box"/>Parado</td>
        </tr>
    </table>

    <table class="osc-sign" style="margin-top: 2mm; page-break-inside: avoid;">
        <tr>
            <td colspan="2" class="osc-small" style="text-align: center;">
                Local e data: ______________________________________, ____/____/________
            </td>
        </tr>
        <tr>
            <td style="width: 50%; padding-top: 13mm;">
                <div class="osc-sign-line">Técnico responsável — nome e assinatura</div>
            </td>
            <td style="padding-top: 13mm;">
                <div class="osc-sign-line">Cliente — nome, assinatura e carimbo</div>
            </td>
        </tr>
    </table>
</template>
</odoo>
